{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chihua",
  "version": "0.27.0",
  "identifier": "com.chihuabrowser",
  "build": {
    "beforeDevCommand": "pnpm copy-proxy-binary && pnpm dev",
    "devUrl": "http://localhost:12341",
    "beforeBuildCommand": "pnpm copy-proxy-binary && (test -d ../dist || pnpm build)",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "externalBin": [
      "binaries/chihua-proxy",
      "binaries/chihua-tunnel",
      "binaries/xray"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "entitlements.plist",
      "files": {
        "Info.plist": "Info.plist"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "chihuabrowser.desktop",
        "depends": [
          "xdg-utils",
          "libxdo3",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "desktopTemplate": "chihuabrowser.desktop",
        "depends": [
          "xdg-utils",
          "libxdo",
          "libayatana-appindicator-gtk3"
        ]
      },
      "appimage": {
        "files": {
          "usr/share/applications/chihuabrowser.desktop": "chihuabrowser.desktop"
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "resources/cloudvpn-ext/": "cloudvpn-ext/",
      "resources/zapret/": "zapret/"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "http",
          "https"
        ]
      }
    }
  }
}
